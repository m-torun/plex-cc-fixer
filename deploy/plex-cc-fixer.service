# A template: deploy/install.sh fills in the @...@ values and installs the result.
[Unit]
Description=plex-cc-fixer daemon: subtitle and cheat sheet generation, cheat sheet pages, API on 127.0.0.1:8766
After=network.target plexmediaserver.service

[Service]
User=@USER@
WorkingDirectory=@CHECKOUT@
ExecStart=@PYTHON@ -m plex_cc_fixer.server --site @DATA@/site --work @DATA@/episodes --port 8766@OPTIONS@
Restart=on-failure
# A generation job runs for half an hour; give it a moment to stop when the service does.
TimeoutStopSec=20

[Install]
WantedBy=multi-user.target
